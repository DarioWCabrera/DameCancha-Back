NODE_ENV=development
PORT=3000
APP_TIMEZONE_OFFSET=-03:00

# PostgreSQL / Neon
# Copiá la connection string desde Neon. Debe comenzar con postgresql://
# En Neon mantené ?sslmode=require (y channel_binding=require si viene incluido).
DATABASE_URL=
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_MS=10000
DB_SYNC=false
DB_LOGGING=false

JWT_SECRET=
JWT_EXPIRES_IN=1d

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000

UPLOAD_DIR=uploads

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Solo para npm run seed en desarrollo/staging.
SEED_PASSWORD=
